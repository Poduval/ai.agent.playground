# Copy to .env (gitignored). Everything has a default except LLM credentials.

# --- LLM: nvidia | ollama | litellm | openai ---
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=            # free key: https://build.nvidia.com
# LLM_MODEL=meta/llama-3.3-70b-instruct
# LLM_BASE_URL=            # override a preset's URL
# LLM_API_KEY=             # override a provider-specific key
# OPENAI_API_KEY=
# LITELLM_API_KEY=         # needed only if your LiteLLM proxy has a master key

# --- Security (change outside localhost) ---
A2A_BEARER_TOKEN=dev-a2a-token

# --- Memory: leave empty for in-process memory, or: redis://localhost:6379/0 ---
REDIS_URL=

# --- Agent identity (also shown in the A2A Agent Card) ---
# AGENT_NAME=Assistant
# AGENT_INSTRUCTIONS=You are a helpful assistant. Use the provided tools ...

# --- MCP servers the agent uses (comma-separated name=url; start them from ../../services) ---
# MCP_SERVERS=calculator=http://127.0.0.1:8001/mcp,weather=http://127.0.0.1:8011/mcp

# --- Service URLs (defaults) ---
# A2A_URL=http://127.0.0.1:8002
